# Serve pre-built Angular dist with Nginx
# The Angular build runs locally (npm run build --configuration production)
# and the dist/ folder is committed to the repo.
# This avoids ng build timeouts on Render's free tier.
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy pre-built Angular app (built locally before pushing)
COPY dist/fashionstore-frontend/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
