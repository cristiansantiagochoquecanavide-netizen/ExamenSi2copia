PROJECT_NAME="FashionStore API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fashionstore_db"
DATABASE_ECHO=False

# Security / JWT
SECRET_KEY="super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq AI & Analítica (Presentación 3 - CU21/CU22)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
