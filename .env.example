# ==============================================================================
# FASHIONSTORE - VARIABLES DE ENTORNO (PLANTILLA / .env.example)
# ==============================================================================

# --- Base de Datos PostgreSQL ---
POSTGRES_DB=fashionstore_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/fashionstore_db

# --- Configuración Backend (FastAPI) ---
PROJECT_NAME="FashionStore API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Gemini AI & Analítica (Presentación 3 - CU21/CU22) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Conectividad y Puertos ---
BACKEND_PORT=8000
FRONTEND_PORT=4200
# Para acceso móvil en red WiFi local, sustituir localhost por su IP LAN (ej. http://192.168.1.15:8000)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

# ==============================================================================
# CREDENCIALES PRECONFIGURADAS DE PRUEBA (WEB & MÓVIL)
# ==============================================================================
# 1. Administrador (Control Total, RBAC, Auditoría y Sucursales)
DEMO_ADMIN_EMAIL=AdminFashion@gmail.com
DEMO_ADMIN_PASSWORD=Admin123

# 2. Encargado de Sucursal (Tienda Física Equipetrol, Stock y Reservas)
DEMO_ENCARGADO_EMAIL=EncargadoSucursal@gmail.com
DEMO_ENCARGADO_PASSWORD=Encargado123

# 3. Cajero (Punto de Venta POS y Cobros en Tienda)
DEMO_CAJERO_EMAIL=CajeroFashion@gmail.com
DEMO_CAJERO_PASSWORD=Cajero123

# 4. Cliente (Catálogo E-commerce, Probador Virtual AR y Reservas Móviles)
DEMO_CLIENTE_EMAIL=ClienteFashion@gmail.com
DEMO_CLIENTE_PASSWORD=Cliente123
